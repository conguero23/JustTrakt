{
  "manifest_version": 3,
  "name": "JustTrakt - Watched on JustWatch",
  "version": "1.7.1",
  "description": "Trakt history on JustWatch, plus movie dates, counts, rewatch reminders and filters on Trakt.",
  "permissions": [
    "storage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://auth.trakt.tv/*",
    "https://api.trakt.tv/*",
    "https://*.justwatch.com/*",
    "https://api.github.com/repos/conguero23/JustTrakt/releases*",
    "https://app.trakt.tv/*",
    "https://trakt.tv/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JustTrakt",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/trakt.svg"
      ],
      "matches": [
        "https://*.justwatch.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.justwatch.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.justwatch.com/*"
      ],
      "js": [
        "content.js",
        "content-features.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.trakt.tv/*",
        "https://trakt.tv/*"
      ],
      "js": [
        "trakt-grid.js",
        "trakt-content.js"
      ],
      "css": [
        "trakt-content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
